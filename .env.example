# API server
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa
SUPABASE_URL=https://your-project.supabase.co
ADMIN_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Admin application (public browser configuration; never put a secret/service key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_URL=http://localhost:3000

# Cloudflare R2 (server-only; never expose these values through VITE_* variables)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=nexa-capture-photos
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_REGION=auto

# Local reconstruction worker (server/local worker only; generate a random 32+ character secret)
WORKER_TOKEN=replace_with_a_long_random_secret
RECONSTRUCTION_PROVIDER=local-colmap
WORKER_API_URL=https://your-api.vercel.app
WORKER_ID=nexa-local-gpu-01
WORKER_POLL_SECONDS=15
RECONSTRUCTION_WORK_ROOT=D:\Nexa-3D-Work\automated
COLMAP_PATH=D:\Nexa-3D-Tools\COLMAP-4.2.0-CUDA\bin\colmap.exe
BLENDER_PATH=D:\Nexa-3D-Tools\Blender-5.2.1\blender-5.2.1-windows-x64\blender.exe
RECONSTRUCTION_QUALITY=medium
