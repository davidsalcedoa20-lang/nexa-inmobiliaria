# API server
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa
SUPABASE_URL=https://your-project.supabase.co
ADMIN_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Admin application (public browser configuration; never put a secret/service key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_URL=http://localhost:3000

# Cloudflare R2 (server-only; never expose these values through VITE_* variables)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=nexa-capture-photos
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_REGION=auto
